# Generate a 32-byte Base64 key; never commit the real value.
STUDIO_MASTER_KEY=
STUDIO_ORIGINS=http://localhost:3000
STUDIO_SETUP_TOKEN=
# DATABASE_URL selects PostgreSQL; otherwise SQLite is stored in STUDIO_DATA_DIR.
# Both modes require a persistent STUDIO_DATA_DIR for privacy and recovery records.
DATABASE_URL=
STUDIO_DB_TLS=false
STUDIO_DATA_DIR=./data
# For independent API service, set its externally visible origin behind TLS proxy.
STUDIO_API_HOST=127.0.0.1
STUDIO_API_PORT=38322
STUDIO_API_ORIGIN=http://127.0.0.1:38322
# Set at frontend build time if using independent API; empty means same-origin Next API.
NEXT_PUBLIC_API_BASE_URL=
# Optional comma-separated trusted self-hosted model hosts; permits their private IPs.
STUDIO_AI_ALLOWED_HOSTS=
STUDIO_WEATHER_ALLOWED_HOSTS=
# Native sherpa-onnx runtime + SenseVoiceSmall INT8 model directory.
STUDIO_SPEECH_RUNTIME=./speech
