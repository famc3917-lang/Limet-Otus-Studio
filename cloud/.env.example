# Copy to cloud/.env and replace every placeholder before deployment.
STUDIO_DOMAIN=studio.example.com
STUDIO_ORIGIN=https://studio.example.com
STUDIO_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
STUDIO_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# One-time token for the first studio setup. Clear it after setup; an empty value never authorises setup.
STUDIO_SETUP_TOKEN=REPLACE_WITH_RANDOM_ONE_TIME_SETUP_TOKEN

# Optional: self-hosted hosts on private networks or plain HTTP, comma-separated (AI model, Open-Meteo).
STUDIO_AI_ALLOWED_HOSTS=
STUDIO_WEATHER_ALLOWED_HOSTS=
